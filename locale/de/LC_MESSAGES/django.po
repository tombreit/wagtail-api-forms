msgstr[0] "Bitte korrigieren Sie %(counter)s Feld"
msgstr[1] "Bitte korrigieren Sie %(counter)s Felder"

#: wagtail_api_forms/formpages/templates/formpages/includes/form_steps.html
msgid "Checking your answers …"
msgstr "Ihre Angaben werden geprüft …"

#: wagtail_api_forms/formpages/templates/formpages/form_page_landing.html
msgid "Thank you"
msgstr "Vielen Dank"

#: wagtail_api_forms/formpages/templates/formpages/form_page_landing.html
msgid "Thank you. Your answers have been sent."
msgstr "Vielen Dank. Ihre Angaben wurden übermittelt."

#: wagtail_api_forms/formpages/templates/formpages/form_page_landing.html
msgid "Fill in the form again"
msgstr "Formular erneut ausfüllen"

#: wagtail_api_forms/formpages/models.py
#, python-format
msgid "Step %(number)s"
msgstr "Schritt %(number)s"

#: wagtail_api_forms/formpages/fields.py
#, python-format
msgid "Max file size: %(size)s."
msgstr "Maximale Dateigröße: %(size)s."

#: wagtail_api_forms/formpages/fields.py
#, python-format
msgid "Valid file types: %(types)s"
msgstr "Erlaubte Dateitypen: %(types)s"

#: wagtail_api_forms/formpages/validators.py
msgid "The uploaded file is empty (0 bytes). Please check the file and try again."
msgstr ""
"Die hochgeladene Datei ist leer (0 Bytes). Bitte prüfen Sie die Datei und "
"versuchen Sie es erneut."

#: wagtail_api_forms/formpages/validators.py
#, python-format
msgid ""
"This form is misconfigured: none of the configured file types (`%(types)s`) "
"are recognised. Please contact the site administrator."
msgstr ""
"Dieses Formular ist fehlerhaft eingerichtet: keiner der eingestellten "
"Dateitypen (`%(types)s`) ist bekannt. Bitte wenden Sie sich an die "
"Administration der Website."

#: wagtail_api_forms/formpages/validators.py
#, python-format
msgid "Unsupported file type. Valid file types: `%(types)s`, got `%(type)s`!"
msgstr ""
"Nicht unterstützter Dateityp. Erlaubte Dateitypen: `%(types)s`, erkannt: "
"`%(type)s`."

#: wagtail_api_forms/formpages/validators.py
#, python-format
msgid ""
"Unacceptable file extension: Valid file extensions: `%(extensions)s`, got "
"`%(extension)s`!"
msgstr ""
"Nicht erlaubte Dateiendung. Erlaubte Dateiendungen: `%(extensions)s`, "
"erhalten: `%(extension)s`."

#: wagtail_api_forms/formpages/validators.py
#, python-format
msgid "Please keep file size under %(max_size)s. Current size is %(size)s."
msgstr ""
"Bitte laden Sie eine Datei kleiner als %(max_size)s hoch. Die Datei hat "
"%(size)s."
